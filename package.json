{
  "name": "bocs-maritime-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-offline-assets.mjs && vite",
    "build": "prisma generate && node scripts/prepare-offline-assets.mjs && tsc && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=dist-server/index.mjs",
    "build:local": "npm run build && npm run build:server",
    "start": "node --env-file-if-exists=.env dist-server/index.mjs",
    "db:init": "prisma db push",
    "preview": "vite preview",
    "test:pdf": "node --test tests/pdf-extraction.test.mjs",
    "test:invoices": "node --test tests/invoice-number.test.mjs",
    "test:offline": "node --test tests/offline.test.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@neondatabase/serverless": "^0.9.4",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "lucide-react": "^0.344.0",
    "material-symbols": "^0.48.0",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swr": "^2.5.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.35",
    "prisma": "^7.10.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
