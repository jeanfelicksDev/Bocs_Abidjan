# Copier en .env (local) ou déclarer dans Vercel > Settings > Environment Variables.
# Ne jamais committer de valeurs réelles.

# Connexion Postgres / Neon (une seule suffit)
BOCS_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Secret de signature des sessions (≥ 32 caractères aléatoires)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Amorçage d'une base vierge : compte administrateur initial (mot de passe ≥ 8 caractères, haché à l'insertion)
BOCS_ADMIN_EMAIL=admin@bocs.ci
BOCS_ADMIN_INITIAL_PASSWORD=

# Démo uniquement : renvoie le code de réinitialisation au navigateur faute de canal e-mail/SMS.
# Laisser à false en production.
ALLOW_DEMO_RESET_CODE=false

# docker-compose (Postgres local)
POSTGRES_USER=bocs_admin
POSTGRES_PASSWORD=
POSTGRES_DB=bocs_db
