# ── BOCS sur serveur interne ─────────────────────────────────────────────────
# Copier en .env puis compléter. Ne jamais versionner le fichier .env.

# Mot de passe de la base PostgreSQL locale (long et aléatoire, ex. : openssl rand -base64 32)
POSTGRES_PASSWORD=

# Secret de signature des sessions (cookie de connexion) : openssl rand -base64 48
# Le changer déconnecte tous les utilisateurs.
SESSION_SECRET=

# Nom interne du serveur, déclaré dans le DNS de l'entreprise
BOCS_DOMAIN=bocs.entreprise.local

# Certificat HTTPS : « internal » (autorité locale de Caddy) ou les fichiers de
# l'autorité de l'entreprise déposés dans deploy/certs/ :
#   BOCS_TLS=/certs/bocs.crt /certs/bocs.key
BOCS_TLS=internal

# ── Portail client sur Internet (facultatif, voir deploy/portail/) ─────────
# Nom public (DNS public pointant vers l'adresse publique de l'entreprise)
# BOCS_PUBLIC_DOMAIN=clients.bocs.ci
# Certificat : e-mail pour Let's Encrypt, ou fichiers déposés dans deploy/certs/
# BOCS_PUBLIC_TLS=informatique@bocs.ci

# ── Lancement sans Docker (npm start) ────────────────────────────────────────
# DB_DRIVER=pg
# DATABASE_URL=postgresql://bocs:MOT_DE_PASSE@localhost:5432/bocs
# PORT=3000
